#!/usr/bin/env zsh
emulate -L zsh
setopt errexit nounset pipefail

apply=false
assume_yes=false
recursive=false
recursive_root=
typeset -a excludes repositories
typeset -a safe_worktree_repos safe_worktree_paths safe_worktree_reasons
typeset -a safe_worktree_shas safe_worktree_branch_refs safe_worktree_modes
typeset -a safe_branch_repos safe_branch_names safe_branch_shas safe_branch_reasons
typeset -A merged_proof_cache
repositories_scanned=0
directories_excluded=0
repositories_skipped=0
unreadable_checkouts=0
kept_items=0
failed_deletions=0

usage() {
  cat <<'EOF'
Usage: tidy-safe [--apply] [--yes] [--recursive [ROOT]] [--exclude NAME_OR_PATH]

Audit a repository and delete only worktrees and branches whose exact commits
are proven safe. The default is a dry run in the current repository.

Options:
  --apply                 Delete the items marked SAFE.
  --yes                   Do not prompt when used with --apply.
  --recursive [ROOT]      Discover and deduplicate repositories below ROOT.
                          ROOT defaults to the current directory.
  --exclude NAME_OR_PATH  Skip a directory tree by directory name or path.
                          Repeat this option to add exclusions.
  -h, --help              Show this help.

Examples:
  tidy-safe
  tidy-safe --apply
  tidy-safe --recursive ~/dev --exclude clipboard-health
  tidy-safe --recursive ~/dev --exclude clipboard-health --apply --yes
EOF
}

die() {
  print -u2 -- "tidy-safe: $1"
  exit 2
}

while (( $# > 0 )); do
  case "$1" in
    --apply)
      apply=true
      ;;
    --yes)
      assume_yes=true
      ;;
    --recursive)
      recursive=true
      if (( $# > 1 )) && [[ "$2" != -* ]]; then
        recursive_root=$2
        shift
      fi
      ;;
    --exclude)
      (( $# > 1 )) || die '--exclude requires a repository name or path'
      excludes+=("$2")
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
  shift
done

if [[ "$assume_yes" == true && "$apply" != true ]]; then
  die '--yes requires --apply'
fi

absolute_directory() {
  local directory=$1
  (cd "$directory" 2>/dev/null && pwd -P)
}

primary_worktree() {
  git -C "$1" worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p' | head -n 1
}

is_excluded() {
  local repository=$1 exclusion absolute_exclusion
  for exclusion in "${excludes[@]}"; do
    if [[ "$exclusion" != */* && "$exclusion" != . && "$exclusion" != .. &&
          ( "$repository" == */"$exclusion" || "$repository" == */"$exclusion"/* ) ]]; then
      return 0
    fi
    absolute_exclusion=$(absolute_directory "$exclusion" 2>/dev/null || true)
    if [[ -n "$absolute_exclusion" &&
          ( "$repository" == "$absolute_exclusion" || "$repository" == "${absolute_exclusion%/}/"* ) ]]; then
      return 0
    fi
  done
  return 1
}

discover_repositories() {
  local root marker candidate common primary exclusion match_kind pattern
  local -a prune_matches
  typeset -A seen_common

  if [[ "$recursive" == true ]]; then
    root=$(absolute_directory "${recursive_root:-$PWD}") || die "recursive root does not exist: ${recursive_root:-$PWD}"
    if is_excluded "$root"; then
      print -- "EXCLUDED directory $root"
      (( directories_excluded += 1 ))
      return
    fi
    for exclusion in "${excludes[@]}"; do
      match_kind=-name
      pattern=$exclusion
      if [[ "$exclusion" == */* || "$exclusion" == . || "$exclusion" == .. ]]; then
        pattern=$(absolute_directory "$exclusion" 2>/dev/null || true)
        [[ -n "$pattern" ]] || continue
        match_kind=-path
      fi
      # find treats these characters as patterns; exclusions are literal names.
      pattern=$(print -r -- "$pattern" | sed 's/[][?*\\]/\\&/g')
      prune_matches+=("$match_kind" "$pattern" -o)
    done
    while IFS= read -r marker; do
      if [[ "$marker" == 'EXCLUDED directory '* ]]; then
        print -r -- "$marker"
        (( directories_excluded += 1 ))
        continue
      fi
      candidate=${marker:h}
      common=$(git -C "$candidate" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
      primary=$(primary_worktree "$candidate" || true)
      if [[ -z "$common" || -z "$primary" ]]; then
        print -- "SKIP checkout $candidate: Git metadata is missing or invalid"
        (( unreadable_checkouts += 1 ))
        continue
      fi
      primary=$(absolute_directory "$primary" 2>/dev/null || true)
      [[ -n "$primary" ]] || continue
      [[ "$primary" == "$root" || "$primary" == "$root"/* ]] || continue
      (( ${+seen_common[$common]} )) && continue
      seen_common[$common]=1
      repositories+=("$primary")
    done < <(
      find "$root" \
        -type d \( "${prune_matches[@]}" -false \) -prune -exec printf 'EXCLUDED directory %s\n' {} \; -o \
        -type d -name node_modules -prune -o \
        -type d -name .git -print -prune -o \
        -type f -name .git -print
    )
    repositories=("${(@on)repositories}")
    return
  fi

  candidate=$(git rev-parse --show-toplevel 2>/dev/null) || die 'not inside a Git worktree'
  primary=$(primary_worktree "$candidate") || die 'cannot determine the primary worktree'
  candidate=$(absolute_directory "$candidate") || die 'cannot resolve the current worktree'
  primary=$(absolute_directory "$primary") || die 'cannot resolve the primary worktree'
  [[ "$candidate" == "$primary" ]] || die "run from the primary worktree: $primary"
  repositories+=("$primary")
}

live_default_remote_ref() {
  local repository=$1 head_ref branch remote_ref
  head_ref=$(
    git -C "$repository" ls-remote --symref origin HEAD 2>/dev/null |
      sed -n 's/^ref: \(refs\/heads\/[^[:space:]]*\)[[:space:]]*HEAD$/\1/p' |
      head -n 1
  )
  [[ -n "$head_ref" ]] || return 1
  branch=${head_ref#refs/heads/}
  remote_ref="refs/remotes/origin/$branch"
  git -C "$repository" show-ref --verify --quiet "$remote_ref" || return 1
  print -- "$remote_ref"
}

merged_pr_head_reason() {
  local repository=$1 default_branch=$2 sha=$3 head=$4
  [[ ( ${#head} == 40 || ${#head} == 64 ) && "$head" != *[^0-9a-f]* ]] || return 1
  if [[ "$head" == "$sha" ]]; then
    print -- "exact head of a PR merged into $default_branch"
    return 0
  fi
  if ! git -C "$repository" cat-file -e "$head^{commit}" 2>/dev/null; then
    # Squash merges do not put the PR's original commits on the default branch.
    # Fetch the immutable head object without changing refs or FETCH_HEAD.
    git -C "$repository" -c gc.auto=0 fetch --no-tags --no-write-fetch-head origin "$head" >/dev/null 2>&1 || return 1
  fi
  if git -C "$repository" merge-base --is-ancestor "$sha" "$head" 2>/dev/null; then
    print -- "included in a PR merged into $default_branch"
    return 0
  fi
  return 1
}

merged_pr_commit_reason() {
  local repository=$1 default_branch=$2 branch=$3 sha=$4 key output head base reason
  key="$repository|$default_branch|$branch|$sha"
  if (( ${+merged_proof_cache[$key]} )); then
    [[ "${merged_proof_cache[$key]}" != no ]] || return 1
    print -- "${merged_proof_cache[$key]}"
    return 0
  fi
  merged_proof_cache[$key]=no
  command -v gh >/dev/null 2>&1 || return 1
  output=
  if [[ -n "$branch" ]]; then
    output=$(
      cd "$repository" &&
        gh pr list --state all --base "$default_branch" --head "$branch" --limit 100 \
          --json headRefOid,mergedAt \
          --jq '.[] | select(.mergedAt != null) | .headRefOid' 2>/dev/null
    ) || output=
  fi
  for head in "${(@f)output}"; do
    if reason=$(merged_pr_head_reason "$repository" "$default_branch" "$sha" "$head"); then
      merged_proof_cache[$key]=$reason
      print -- "$reason"
      return 0
    fi
  done
  # Detached worktrees and local branch aliases still have a commit SHA.
  output=$(
    cd "$repository" &&
      gh api "repos/{owner}/{repo}/commits/$sha/pulls" --paginate \
        --jq '.[] | select(.merged_at != null) | [.base.ref, .head.sha] | @tsv' 2>/dev/null
  ) || return 1
  while IFS=$'\t' read -r base head; do
    [[ "$base" == "$default_branch" ]] || continue
    if reason=$(merged_pr_head_reason "$repository" "$default_branch" "$sha" "$head"); then
      merged_proof_cache[$key]=$reason
      print -- "$reason"
      return 0
    fi
  done < <(print -r -- "$output")
  return 1
}

safe_commit_reason() {
  local repository=$1 default_ref=$2 branch=$3 sha=$4 default_branch
  default_branch=${default_ref#refs/remotes/origin/}
  if git -C "$repository" merge-base --is-ancestor "$sha" "$default_ref"; then
    print -- "merged into ${default_ref#refs/remotes/}"
    return 0
  fi
  merged_pr_commit_reason "$repository" "$default_branch" "$branch" "$sha"
}

registered_git_directory() {
  local repository=$1 worktree=$2 common directory registered_path
  common=$(git -C "$repository" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
  if [[ "$worktree" == "$repository" ]]; then
    git -C "$repository" rev-parse --path-format=absolute --absolute-git-dir 2>/dev/null
    return
  fi
  for directory in "$common"/worktrees/*(N/); do
    [[ -f "$directory/gitdir" ]] || continue
    registered_path=$(<"$directory/gitdir")
    if [[ "$registered_path" == "$worktree/.git" ]]; then
      print -r -- "$directory"
      return 0
    fi
  done
  return 1
}

in_progress_operation() {
  local worktree=$1 git_directory=${2:-} marker
  if [[ -z "$git_directory" ]]; then
    [[ -d "$worktree" && -e "$worktree/.git" ]] || return 0
    git_directory=$(git -C "$worktree" rev-parse --absolute-git-dir 2>/dev/null) || return 0
  fi
  [[ -d "$git_directory" && -f "$git_directory/HEAD" ]] || return 0
  # REBASE_HEAD may remain after a rebase ends. Rebase directories record
  # active state; merge and sequencer markers are worktree-local files.
  for marker in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD BISECT_START rebase-apply rebase-merge sequencer; do
    [[ -e "$git_directory/$marker" ]] && return 0
  done
  return 1
}

repository_has_git_operation() {
  local repository=$1 common directory
  common=$(git -C "$repository" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 0
  in_progress_operation "$repository" "$common" && return 0
  for directory in "$common"/worktrees/*(N/); do
    [[ -f "$directory/gitdir" ]] || return 0
    in_progress_operation "$repository" "$directory" && return 0
  done
  return 1
}

orphaned_worktree_is_clean() {
  local git_directory=$1 worktree=$2
  [[ -d "$worktree" && ! -L "$worktree" && ! -e "$worktree/.git" && ! -L "$worktree/.git" ]] || return 1
  recoverable_worktree_contents "$git_directory" "$worktree"
}

recorded_ignores_cover_untracked() {
  local git_directory=$1 worktree=$2 untracked=$3 scratch global_ignore info_exclude ignore_case
  local candidate relative parent ignore_path
  local -a candidates
  candidates=("${(@0)untracked}")
  scratch=$(mktemp -d "${TMPDIR:-/tmp}/tidy-safe-ignores.XXXXXX") || return 1
  (
    trap 'rm -rf -- "$scratch"' EXIT
    git -c init.templateDir= init -q --initial-branch=tidy-safe-check "$scratch" >/dev/null 2>&1 || exit 1
    mkdir -p "$scratch/.git/info"
    info_exclude=$(git --git-dir="$git_directory" rev-parse --path-format=absolute --git-path info/exclude 2>/dev/null) || exit 1
    if [[ -f "$info_exclude" ]]; then
      cp -- "$info_exclude" "$scratch/.git/info/exclude" || exit 1
    fi
    if ! global_ignore=$(git --git-dir="$git_directory" config --path --get core.excludesFile 2>/dev/null); then
      global_ignore="${XDG_CONFIG_HOME:-$HOME/.config}/git/ignore"
    fi
    ignore_case=$(git --git-dir="$git_directory" config --bool --get core.ignoreCase 2>/dev/null || true)
    [[ "$ignore_case" == true ]] || ignore_case=false
    # Relative exclusion paths are not safe to reinterpret in another directory.
    [[ "$global_ignore" == /* && -f "$global_ignore" ]] || global_ignore=/dev/null
    for candidate in "${candidates[@]}"; do
      [[ -n "$candidate" ]] || continue
      relative=${candidate%/}
      [[ -e "$worktree/$relative" || -L "$worktree/$relative" ]] || exit 1
      parent=${relative:h}
      while true; do
        ignore_path="$parent/.gitignore"
        [[ "$parent" == . ]] && ignore_path=.gitignore
        mkdir -p -- "$scratch/$parent" || exit 1
        if [[ -e "$worktree/$ignore_path" || -L "$worktree/$ignore_path" ]]; then
          [[ -f "$worktree/$ignore_path" && ! -L "$worktree/$ignore_path" ]] || exit 1
          cp -- "$worktree/$ignore_path" "$scratch/$ignore_path" || exit 1
        elif ! git --git-dir="$git_directory" show "HEAD:$ignore_path" > "$scratch/$ignore_path" 2>/dev/null; then
          rm -f -- "$scratch/$ignore_path"
        fi
        [[ "$parent" == . ]] && break
        parent=${parent:h}
      done
      if [[ -d "$worktree/$relative" && ! -L "$worktree/$relative" ]]; then
        mkdir -p -- "$scratch/$relative" || exit 1
      elif [[ ! -e "$scratch/$relative" ]]; then
        : > "$scratch/$relative" || exit 1
      fi
      # Git evaluates root and nested negations with their normal precedence.
      git -C "$scratch" -c core.excludesFile="$global_ignore" -c core.ignoreCase="$ignore_case" check-ignore --no-index -q -- "$relative" || exit 1
    done
  )
}

staged_index_is_recoverable() {
  git --git-dir="$1" diff --cached --quiet --ignore-submodules=none --diff-filter=ACMRTUXB HEAD -- 2>/dev/null
}

recoverable_worktree_contents() {
  local git_directory=$1 worktree=$2 untracked deleted_ignores
  # A partial removal can contain deletions, but must not discard unique data
  # in the index, surviving tracked files, or non-ignored untracked files.
  staged_index_is_recoverable "$git_directory" || return 1
  git --git-dir="$git_directory" --work-tree="$worktree" diff --quiet --ignore-submodules=none --diff-filter=ACMRTUXB HEAD -- 2>/dev/null || return 1
  deleted_ignores=$(git --git-dir="$git_directory" --work-tree="$worktree" diff --name-only --diff-filter=D HEAD -- .gitignore ':(glob)**/.gitignore' 2>/dev/null) || return 1
  if [[ -z "$deleted_ignores" ]]; then
    untracked=$(git --git-dir="$git_directory" --work-tree="$worktree" ls-files --full-name --others --exclude-standard --directory --no-empty-directory 2>/dev/null) || return 1
    [[ -z "$untracked" ]]
    return
  fi
  # Missing ignore files can expose generated directories or conceal negations.
  # Reconstruct only the ignore hierarchy in a disposable repository; no files
  # or Git markers are written into the audited worktree during the audit.
  untracked=$(git --git-dir="$git_directory" --work-tree="$worktree" ls-files --full-name --others --directory --no-empty-directory -z 2>/dev/null) || return 1
  [[ -n "$untracked" ]] || return 0
  recorded_ignores_cover_untracked "$git_directory" "$worktree" "$untracked"
}

audit_worktree() {
  local repository=$1 default_ref=$2 worktree_path=$3 branch_ref=$4 locked=$5 prunable=$6
  local worktree_status sha branch reason git_directory mode=live
  [[ "$worktree_path" != "$repository" ]] || return 0

  if is_excluded "$worktree_path"; then
    print -- "  KEEP worktree $worktree_path: excluded"
    (( kept_items += 1 ))
    return 0
  fi
  if [[ "$locked" == true ]]; then
    print -- "  KEEP worktree $worktree_path: locked"
    (( kept_items += 1 ))
    return 0
  fi
  if [[ "$prunable" == true || ! -e "$worktree_path" ]]; then
    mode=missing
    [[ -e "$worktree_path" || -L "$worktree_path" ]] && mode=orphaned
    git_directory=$(registered_git_directory "$repository" "$worktree_path") || {
      print -- "  KEEP worktree $worktree_path: registration unavailable"
      (( kept_items += 1 ))
      return 0
    }
    if [[ "$mode" == missing ]] && ! staged_index_is_recoverable "$git_directory"; then
      print -- "  KEEP worktree $worktree_path: staged changes or unreadable index"
      (( kept_items += 1 ))
      return 0
    fi
    if in_progress_operation "$worktree_path" "$git_directory"; then
      print -- "  KEEP worktree $worktree_path: Git operation in progress"
      (( kept_items += 1 ))
      return 0
    fi
    if [[ "$mode" == orphaned ]] && ! orphaned_worktree_is_clean "$git_directory" "$worktree_path"; then
      print -- "  KEEP worktree $worktree_path: modified or untracked files"
      (( kept_items += 1 ))
      return 0
    fi
    sha=$(git --git-dir="$git_directory" rev-parse --verify HEAD 2>/dev/null) || {
      print -- "  KEEP worktree $worktree_path: HEAD unavailable"
      (( kept_items += 1 ))
      return 0
    }
  else
    if [[ "$prunable" == true || ! -d "$worktree_path" ]]; then
      print -- "  KEEP worktree $worktree_path: registration is stale or path is missing"
      (( kept_items += 1 ))
      return 0
    fi
    if ! worktree_status=$(git -C "$worktree_path" status --porcelain=v1 --untracked-files=all 2>/dev/null); then
      print -- "  KEEP worktree $worktree_path: status unavailable"
      (( kept_items += 1 ))
      return 0
    fi
    if [[ -n "$worktree_status" ]]; then
      git_directory=$(git -C "$worktree_path" rev-parse --absolute-git-dir 2>/dev/null) || git_directory=
      if [[ -n "$git_directory" ]] && recoverable_worktree_contents "$git_directory" "$worktree_path"; then
        mode=partial
      else
        print -- "  KEEP worktree $worktree_path: dirty"
        (( kept_items += 1 ))
        return 0
      fi
    fi
    if in_progress_operation "$worktree_path"; then
      print -- "  KEEP worktree $worktree_path: Git operation in progress"
      (( kept_items += 1 ))
      return 0
    fi
    sha=$(git -C "$worktree_path" rev-parse --verify HEAD 2>/dev/null) || {
      print -- "  KEEP worktree $worktree_path: HEAD unavailable"
      (( kept_items += 1 ))
      return 0
    }
  fi
  branch=${branch_ref#refs/heads/}
  [[ "$branch" != "$branch_ref" ]] || branch=
  if ! reason=$(safe_commit_reason "$repository" "$default_ref" "$branch" "$sha"); then
    print -- "  KEEP worktree $worktree_path: unmerged"
    (( kept_items += 1 ))
    return 0
  fi

  case "$mode" in
    partial) reason="only recoverable deletions; $reason" ;;
    missing) reason="stale registration; $reason" ;;
    orphaned) reason="stale registration with recoverable files; $reason" ;;
  esac
  print -- "  SAFE worktree $worktree_path: $reason"
  safe_worktree_repos+=("$repository")
  safe_worktree_paths+=("$worktree_path")
  safe_worktree_reasons+=("$reason")
  safe_worktree_shas+=("$sha")
  safe_worktree_branch_refs+=("$branch_ref")
  safe_worktree_modes+=("$mode")
}

audit_repository() {
  local repository=$1 default_ref default_branch remote_url branch_cleanup_blocked=false
  local worktree_path= branch_ref= locked=false prunable=false line branch sha reason
  typeset -A safe_paths checked_out_refs

  if is_excluded "$repository"; then
    print -- "EXCLUDED directory $repository"
    (( directories_excluded += 1 ))
    return 0
  fi

  print -- "REPOSITORY $repository"
  remote_url=$(git -C "$repository" remote get-url origin 2>/dev/null || true)
  if [[ -z "$remote_url" ]]; then
    print -- '  SKIP repository: origin remote is missing'
    (( repositories_skipped += 1 ))
    return 0
  fi
  if ! git -C "$repository" fetch --prune origin >/dev/null 2>&1; then
    print -- '  SKIP repository: fetch failed'
    (( repositories_skipped += 1 ))
    return 0
  fi
  default_ref=$(live_default_remote_ref "$repository" || true)
  if [[ -z "$default_ref" ]]; then
    print -- '  SKIP repository: remote default branch is ambiguous or missing'
    (( repositories_skipped += 1 ))
    return 0
  fi
  default_branch=${default_ref#refs/remotes/origin/}
  (( repositories_scanned += 1 ))

  evaluate_block() {
    [[ -n "$worktree_path" ]] || return 0
    audit_worktree "$repository" "$default_ref" "$worktree_path" "$branch_ref" "$locked" "$prunable"
    worktree_path=
    branch_ref=
    locked=false
    prunable=false
  }

  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ -z "$line" ]]; then
      evaluate_block
      continue
    fi
    case "$line" in
      'worktree '*) worktree_path=${line#worktree } ;;
      'branch '*) branch_ref=${line#branch } ;;
      locked*) locked=true ;;
      prunable*) prunable=true ;;
    esac
  done < <(git -C "$repository" worktree list --porcelain; print)

  local safe_path
  for safe_path in "${safe_worktree_paths[@]}"; do
    safe_paths[$safe_path]=1
  done
  worktree_path=
  branch_ref=
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ -z "$line" ]]; then
      if [[ -n "$worktree_path" && -n "$branch_ref" ]] && (( ! ${+safe_paths[$worktree_path]} )); then
        checked_out_refs[$branch_ref]=1
      fi
      worktree_path=
      branch_ref=
      continue
    fi
    case "$line" in
      'worktree '*) worktree_path=${line#worktree } ;;
      'branch '*) branch_ref=${line#branch } ;;
    esac
  done < <(git -C "$repository" worktree list --porcelain; print)

  repository_has_git_operation "$repository" && branch_cleanup_blocked=true
  while IFS= read -r branch; do
    [[ -n "$branch" && "$branch" != "$default_branch" ]] || continue
    (( ${+checked_out_refs[refs/heads/$branch]} )) && continue
    if [[ "$branch_cleanup_blocked" == true ]]; then
      print -- "  KEEP branch $branch: Git operation in progress or worktree status unavailable"
      (( kept_items += 1 ))
      continue
    fi
    sha=$(git -C "$repository" rev-parse --verify "refs/heads/$branch")
    if ! reason=$(safe_commit_reason "$repository" "$default_ref" "$branch" "$sha"); then
      print -- "  KEEP branch $branch: unmerged"
      (( kept_items += 1 ))
      continue
    fi
    print -- "  SAFE branch $branch: $reason"
    safe_branch_repos+=("$repository")
    safe_branch_names+=("$branch")
    safe_branch_shas+=("$sha")
    safe_branch_reasons+=("$reason")
  done < <(git -C "$repository" for-each-ref --format='%(refname:short)' refs/heads)
}

branch_is_checked_out() {
  local repository=$1 branch=$2
  git -C "$repository" worktree list --porcelain | grep -qxF -- "branch refs/heads/$branch"
}

worktree_registration_matches() {
  local repository=$1 target_path=$2 expected_branch_ref=$3 allow_prunable=${4:-false}
  local worktree_path= branch_ref= locked=false prunable=false line

  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ -z "$line" ]]; then
      if [[ "$worktree_path" == "$target_path" ]]; then
        [[ "$locked" == false && ( "$prunable" == false || "$allow_prunable" == true ) && "$branch_ref" == "$expected_branch_ref" ]]
        return
      fi
      worktree_path=
      branch_ref=
      locked=false
      prunable=false
      continue
    fi
    case "$line" in
      'worktree '*) worktree_path=${line#worktree } ;;
      'branch '*) branch_ref=${line#branch } ;;
      locked*) locked=true ;;
      prunable*) prunable=true ;;
    esac
  done < <(git -C "$repository" worktree list --porcelain 2>/dev/null; print)
  return 1
}

worktree_still_safe() {
  local repository=$1 worktree_path=$2 expected_sha=$3 expected_branch_ref=$4
  local worktree_status actual_sha branch default_ref git_directory
  local mode=${5:-live}

  if [[ "$mode" != live ]]; then
    if [[ "$mode" == partial ]]; then
      worktree_registration_matches "$repository" "$worktree_path" "$expected_branch_ref" || return 1
      git_directory=$(git -C "$worktree_path" rev-parse --absolute-git-dir 2>/dev/null) || return 1
      recoverable_worktree_contents "$git_directory" "$worktree_path" || return 1
    else
      if [[ "$mode" == missing ]]; then
        [[ ! -e "$worktree_path" && ! -L "$worktree_path" ]] || return 1
      fi
      worktree_registration_matches "$repository" "$worktree_path" "$expected_branch_ref" true || return 1
      git_directory=$(registered_git_directory "$repository" "$worktree_path") || return 1
      [[ "$mode" != orphaned ]] || orphaned_worktree_is_clean "$git_directory" "$worktree_path" || return 1
    fi
    in_progress_operation "$worktree_path" "$git_directory" && return 1
    actual_sha=$(git --git-dir="$git_directory" rev-parse --verify HEAD 2>/dev/null) || return 1
  else
    [[ -d "$worktree_path" ]] || return 1
    worktree_registration_matches "$repository" "$worktree_path" "$expected_branch_ref" || return 1
    worktree_status=$(git -C "$worktree_path" status --porcelain=v1 --untracked-files=all 2>/dev/null) || return 1
    [[ -z "$worktree_status" ]] || return 1
    in_progress_operation "$worktree_path" && return 1
    actual_sha=$(git -C "$worktree_path" rev-parse --verify HEAD 2>/dev/null) || return 1
  fi
  [[ "$mode" != missing ]] || staged_index_is_recoverable "$git_directory" || return 1
  [[ "$actual_sha" == "$expected_sha" ]] || return 1
  git -C "$repository" fetch --prune origin >/dev/null 2>&1 || return 1
  default_ref=$(live_default_remote_ref "$repository" || true)
  [[ -n "$default_ref" ]] || return 1
  branch=${expected_branch_ref#refs/heads/}
  [[ "$branch" != "$expected_branch_ref" ]] || branch=
  safe_commit_reason "$repository" "$default_ref" "$branch" "$actual_sha" >/dev/null || return 1
  if [[ "$mode" != live ]]; then
    if [[ "$mode" == missing ]]; then
      [[ ! -e "$worktree_path" && ! -L "$worktree_path" ]] || return 1
      staged_index_is_recoverable "$git_directory" || return 1
    elif [[ "$mode" == partial ]]; then
      worktree_registration_matches "$repository" "$worktree_path" "$expected_branch_ref" || return 1
      [[ "$(git -C "$worktree_path" rev-parse --absolute-git-dir 2>/dev/null)" == "$git_directory" ]] || return 1
      recoverable_worktree_contents "$git_directory" "$worktree_path" || return 1
    else
      orphaned_worktree_is_clean "$git_directory" "$worktree_path" || return 1
    fi
    worktree_registration_matches "$repository" "$worktree_path" "$expected_branch_ref" true || return 1
    in_progress_operation "$worktree_path" "$git_directory" && return 1
    [[ "$(git --git-dir="$git_directory" rev-parse --verify HEAD 2>/dev/null)" == "$expected_sha" ]] || return 1
  fi
  return 0
}

apply_deletions() {
  local index repository worktree_path branch expected_sha expected_branch_ref actual_sha default_ref reason config_keys config_key

  for (( index = 1; index <= ${#safe_worktree_paths[@]}; index++ )); do
    repository=${safe_worktree_repos[$index]}
    worktree_path=${safe_worktree_paths[$index]}
    reason=${safe_worktree_reasons[$index]}
    expected_sha=${safe_worktree_shas[$index]}
    expected_branch_ref=${safe_worktree_branch_refs[$index]}
    if ! worktree_still_safe "$repository" "$worktree_path" "$expected_sha" "$expected_branch_ref" "${safe_worktree_modes[$index]}"; then
      print -u2 -- "FAILED worktree $worktree_path: changed or no longer proven safe after audit"
      (( failed_deletions += 1 ))
      continue
    fi
    local -a remove_options
    remove_options=()
    [[ "${safe_worktree_modes[$index]}" == partial ]] && remove_options=(--force)
    if [[ "${safe_worktree_modes[$index]}" == orphaned ]]; then
      local git_directory repaired_directory
      git_directory=$(registered_git_directory "$repository" "$worktree_path") || git_directory=
      # Restore only this registration's marker, without overwriting a file
      # another process created. Then recheck before allowing deletions.
      if [[ -z "$git_directory" ]] || ! (setopt noclobber; print -r -- "gitdir: $git_directory" > "$worktree_path/.git") 2>/dev/null; then
        print -u2 -- "FAILED worktree $worktree_path: registration repair failed"
        (( failed_deletions += 1 ))
        continue
      fi
      repaired_directory=$(git -C "$worktree_path" rev-parse --absolute-git-dir 2>/dev/null || true)
      actual_sha=$(git -C "$worktree_path" rev-parse --verify HEAD 2>/dev/null || true)
      if [[ "$repaired_directory" != "$git_directory" || "$actual_sha" != "$expected_sha" ]] ||
         ! worktree_registration_matches "$repository" "$worktree_path" "$expected_branch_ref" ||
         ! recoverable_worktree_contents "$git_directory" "$worktree_path" ||
         in_progress_operation "$worktree_path" "$git_directory"; then
        print -u2 -- "FAILED worktree $worktree_path: changed during registration repair"
        (( failed_deletions += 1 ))
        continue
      fi
      remove_options=(--force)
    fi
    if git -C "$repository" worktree remove "${remove_options[@]}" "$worktree_path"; then
      print -- "REMOVED worktree $worktree_path: $reason"
    else
      print -u2 -- "FAILED worktree $worktree_path: remove failed"
      (( failed_deletions += 1 ))
    fi
  done

  for (( index = 1; index <= ${#safe_branch_names[@]}; index++ )); do
    repository=${safe_branch_repos[$index]}
    branch=${safe_branch_names[$index]}
    expected_sha=${safe_branch_shas[$index]}
    reason=${safe_branch_reasons[$index]}
    actual_sha=$(git -C "$repository" rev-parse --verify "refs/heads/$branch" 2>/dev/null || true)
    if [[ "$actual_sha" != "$expected_sha" || -z "$actual_sha" ]]; then
      print -u2 -- "FAILED branch $branch: branch changed after audit"
      (( failed_deletions += 1 ))
      continue
    fi
    if branch_is_checked_out "$repository" "$branch" || repository_has_git_operation "$repository"; then
      print -u2 -- "FAILED branch $branch: checked out or Git operation in progress"
      (( failed_deletions += 1 ))
      continue
    fi
    if ! git -C "$repository" fetch --prune origin >/dev/null 2>&1; then
      print -u2 -- "FAILED branch $branch: fetch failed during revalidation"
      (( failed_deletions += 1 ))
      continue
    fi
    default_ref=$(live_default_remote_ref "$repository" || true)
    if [[ -z "$default_ref" ]] || ! safe_commit_reason "$repository" "$default_ref" "$branch" "$actual_sha" >/dev/null; then
      print -u2 -- "FAILED branch $branch: no longer proven safe"
      (( failed_deletions += 1 ))
      continue
    fi
    # Recheck local state after network revalidation. The exact audited commit
    # is already proven safe against the live remote default; branch -d would
    # instead test potentially outdated local HEAD or upstream history.
    actual_sha=$(git -C "$repository" rev-parse --verify "refs/heads/$branch" 2>/dev/null || true)
    if [[ "$actual_sha" != "$expected_sha" ]] || branch_is_checked_out "$repository" "$branch" || repository_has_git_operation "$repository"; then
      print -u2 -- "FAILED branch $branch: changed or checked out during revalidation"
      (( failed_deletions += 1 ))
      continue
    fi
    # Git compares the audited SHA while holding the ref lock. A concurrent
    # branch update must fail deletion, rather than lose its unmerged tip.
    if git -C "$repository" update-ref --no-deref -d "refs/heads/$branch" "$expected_sha"; then
      print -- "REMOVED branch $branch: $reason"
      if git -C "$repository" show-ref --verify --quiet "refs/heads/$branch"; then
        print -u2 -- "WARN branch $branch: recreated after deletion; configuration retained"
        continue
      fi
      if ! config_keys=$(git -C "$repository" config --local --name-only --list); then
        print -u2 -- "FAILED branch $branch: deleted, but could not read branch configuration"
        (( failed_deletions += 1 ))
        continue
      fi
      for config_key in "${(@f)config_keys}"; do
        [[ "${config_key%.*}" == "branch.$branch" ]] || continue
        if ! git -C "$repository" config --local --remove-section "branch.$branch"; then
          print -u2 -- "FAILED branch $branch: deleted, but configuration cleanup failed"
          (( failed_deletions += 1 ))
        fi
        break
      done
    else
      print -u2 -- "FAILED branch $branch: delete failed"
      (( failed_deletions += 1 ))
    fi
  done
}

discover_repositories
for repository in "${repositories[@]}"; do
  audit_repository "$repository"
done

print --
print -- "Repositories scanned: $repositories_scanned"
print -- "Directories excluded: $directories_excluded"
print -- "Repositories skipped: $repositories_skipped"
print -- "Unreadable checkouts: $unreadable_checkouts"
print -- "SAFE worktrees: ${#safe_worktree_paths[@]}"
print -- "SAFE branches: ${#safe_branch_names[@]}"
print -- "Kept items: $kept_items"

if [[ "$apply" != true ]]; then
  print -- 'Dry run: rerun with --apply to delete only the SAFE items.'
  exit 0
fi

if (( ${#safe_worktree_paths[@]} == 0 && ${#safe_branch_names[@]} == 0 )); then
  print -- 'Nothing safe to delete.'
  exit 0
fi

if [[ "$assume_yes" != true ]]; then
  print -n -- 'Delete all items marked SAFE? [y/N] '
  read -r confirmation
  [[ "$confirmation" == [Yy] ]] || {
    print -- 'No changes made.'
    exit 0
  }
fi

apply_deletions
(( failed_deletions == 0 )) || exit 1
